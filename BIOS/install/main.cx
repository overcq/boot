#define Q_filesystem_S_file_loader_data         224
//==============================================================================
struct __attribute__(( __packed__ )) E_disc_Z_gpt_header
{ N64 signature;
  N32 revision;
  N32 size;
  N32 crc32;
  N32 reserved;
  N64 my_lba;
  N64 alternate_lba;
  N64 first_usable_lba;
  N64 last_usable_lba;
  N8 disc_guid[16];
  N64 partition_entry_lba;
  N32 partition_entry_count;
  N32 partition_entry_size;
  N32 partition_entry_crc32;
};
struct __attribute__(( __packed__ )) E_disc_Z_gpt_partition_record
{ N8 type_guid[16];
  N8 unique_guid[16];
  N64 start_lba;
  N64 end_lba;
  N64 required      :1;
  N64 no_block_io   :1;
  N64 legacy_bios   :1;
  N64 reserved      :45;
  N64 guid_reserved :16;
  C name[72];
};
//==============================================================================
int
main( int argc
, char *argv[]
){  E_base_M( argc, argv );
    N logical_block_size = 512;
    Pc device = 0;
    Pc file = 0;
    B option = no;
    B floppy = no;
    for( int i = 1; i != argc; i++ )
    {   if( option )
        {   if( E_text_Z_s0_T_eq_s0( argv[i], "floppy" ))
                floppy = yes;
            else if( E_text_Z_s0_T_eq_s0( argv[i], "disk" ))
                floppy = no;
            else
                goto Error;
            option = no;
            continue;
        }
        if( *argv[i] == '-' )
        {   if( E_text_Z_s0_T_eq_s0( argv[i] + 1, "o" ))
            {   option = yes;
                continue;
            }
            goto Error;
        }
        if(file)
            goto Error;
        if(device)
            file = argv[i];
        else
            device = argv[i];
    }
    if( !device
    || !file
    || option
    )
        goto Error;
    I device_file_id;
    if( !~( device_file_id = E_mem_Q_file_M( device, no, 0 )))
        goto Error;
    if( E_mem_Q_file_P_pos( device_file_id, logical_block_size ))
        goto Error_2;
    struct E_disc_Z_gpt_header gpt_header;
    if( E_mem_Q_file_R_s( device_file_id, ( Pc )&gpt_header, sizeof( gpt_header )))
        goto Error_2;
    struct E_disc_Z_gpt_partition_record gpt_partition_record;
    N i = 0;
    O{  if( E_mem_Q_file_P_pos( device_file_id, gpt_header.partition_entry_lba * logical_block_size + i * gpt_header.partition_entry_size ))
            goto Error_2;
        if( E_mem_Q_file_R_s( device_file_id, ( Pc )&gpt_partition_record, sizeof( gpt_partition_record )))
            goto Error_2;
        if( E_text_Z_sl_T_eq(( Pc )&gpt_partition_record.type_guid[0], "\x48\x61\x68\x21\x49\x64\x6f\x6e\x74\x4e\x65\x65\x64\x45\x46\x49", sizeof( gpt_partition_record.type_guid )))
            break;
        if( ++i == gpt_header.partition_entry_count )
            goto Error_2;
    }
    N file_pos_sectors = gpt_partition_record.start_lba * logical_block_size / 512;
    N heads = floppy ? 2 : 16;
    N sectors = floppy ? 18 : 63;
    if( file_pos_sectors / ( heads * sectors ) > 1024 ) /// Za dużo cylindrów dla adresu CHS 1024/16/63 lub 1024/2/18.
        goto Error_2;
    struct stat stat_;
    V0( stat( file, &stat_ ))
        goto Error_2;
    N file_size = stat_.st_size;
    if( file_size > 255 * 512 ) /// Za duży rozmiar pliku dla liczby sektorów w bajcie.
        goto Error_2;
    N cylinder = file_pos_sectors / ( heads * sectors );
    file_pos_sectors %= heads * sectors;
    N head = file_pos_sectors / sectors;
    file_pos_sectors %= sectors;
    N sector = (( cylinder & ( 3 << 8 )) >> 2 ) | ( file_pos_sectors + 1 );
    if( E_mem_Q_file_P_pos( device_file_id, Q_filesystem_S_file_loader_data ))
        goto Error_2;
    if( E_mem_Q_file_P_n( device_file_id, head, 1 ))
        goto Error_2;
    if( E_mem_Q_file_P_n( device_file_id, sector, 1 ))
        goto Error_2;
    if( E_mem_Q_file_P_n( device_file_id, cylinder, 1 ))
        goto Error_2;
    if( E_mem_Q_file_P_n( device_file_id, file_size / 512 + ( file_size % 512 ? 1 : 0 ), 1 ))
        goto Error_2;
    E_mem_Q_file_W( device_file_id );
    E_base_W();
    return 0;
Error_2:
    E_mem_Q_file_W( device_file_id );
Error:
    E_base_W();
    return 1;
}
